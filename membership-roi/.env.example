APP_NAME="IQBIT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=membership_roi
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Explorer API (BEP20 USDT deposit polling) ---
# This app polls token transfers to detect BEP20 USDT deposits.
#
# Recommended (BscScan):
# BSCSCAN_API_BASE=https://api.bscscan.com/api
# BSCSCAN_API_KEY=your_key
# BSCSCAN_CHAIN_ID=56
#
# If you want to use an Etherscan "multichain V2" base URL instead, set:
# BSCSCAN_API_BASE=https://api.etherscan.io/v2/api
# ETHERSCAN_API_KEY=your_key
#
# Note: whether `api.etherscan.io/v2/api` supports BSC depends on your key/plan.
BSCSCAN_API_BASE=https://api.bscscan.com/api
BSCSCAN_API_KEY=
BSCSCAN_CHAIN_ID=56
USDT_BEP20_CONTRACT=0x55d398326f99059fF775485246999027B3197955
ETHERSCAN_API_KEY=
ETHERSCAN_API_BASE=https://api.etherscan.io/v2/api
